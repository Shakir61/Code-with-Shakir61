#include <iostream>
using namespace std;

class Node{
public:
   int data;
   Node *next;
   
   Node(int val)
   {
       data = value;
       next = NULL;
   }
   
};

class List{
  Node *head;
  Node *tail;
  
public: 
  List()
  {
      head = tail = NULL;
  }
  
  void push_front(int value)
  {
      Node* newNode = new Node(value); // dynamic object.
      if(head == NULL)
      {
          head = tail = newNode;
          return;
      }
      else
      {
          newNode->next=head;
          head=newNode;
      }
  }
void push_back(int value)
  {
      Node* newNode=new Node(value);
      if(head == NULL)
      {
          head = tail = NULL;
          return;
      }
      else
      {
          tail->next=newNode;
          newNode=tail;
      }
  }
  
  void pop_front()
  {
      if(head == NULL)
      {
          cout << "The linked list is empty..." << endl;
          return;
      }
          Node *temp=head;
          head=head->next;
          temp->next = NULL;
          
          cout << "Node containing " << temp->data << " deleted successfully.." << endl;
          delete temp;
      
  }
  
  void pop_back()
  {
      if(head == NULL)
      {
          cout << "The linked list is empty..." << endl;
          return;
      }
      
      Node* temp = head;
      while(temp->next!=tail)
      {
          temp=temp->next;
      }
          temp->next=NULL;
          
          cout << "Node containing " << tail->data << " deleted successfully.." << endl;
          delete tail;
          tail = temp;
  }
  
  void printLL()
  {
      Node* temp = head;
      cout << "Values inside the linked list: " << endl;
      while(temp != NULL)
      {
          cout << temp->data << "->";
          temp = temp->next;
      }
      cout << "NULL" << endl;
  }

};

